+fn temp_dir(name: &str) -> PathBuf {
+    let nanos = SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .unwrap()
+        .as_nanos();
+    let path = std::env::temp_dir().join(format!("version-and-commit-{name}-{nanos}"));
+    fs::create_dir_all(&path).unwrap();
+    path
+}

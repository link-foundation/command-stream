+    fixture_git(repo, &["config", "user.email", "test@example.com"]);
+    fs::write(repo.join("Cargo.toml"), "version = \"1.4.0\"\n").unwrap();
+    fixture_git(repo, &["add", "Cargo.toml"]);
+    fixture_git(repo, &["commit", "-qm", "base"]);
+}

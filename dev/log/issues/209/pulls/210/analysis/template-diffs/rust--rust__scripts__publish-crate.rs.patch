 #[path = "rust-paths.rs"]
 mod rust_paths;
 
+fn publish_command(manifest: &std::path::Path, token: Option<&str>) -> Command {
+    let mut cmd = Command::new("cargo");
+    cmd.arg("publish")
+        .arg("--allow-dirty")
+        .arg("--manifest-path")
+        .arg(manifest);
+    if let Some(token) = token {
+        cmd.env("CARGO_REGISTRY_TOKEN", token);
+    }
+    cmd
+}

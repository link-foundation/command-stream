+#[cfg(test)]
+mod credential_tests {
+    use super::*;
+    #[test]
+    fn publish_keeps_credentials_out_of_command_arguments() {
+        let cmd = publish_command(std::path::Path::new("rust/Cargo.toml"), Some("test-token"));
+        assert!(
+            !cmd.get_args()
+                .any(|arg| arg == "--token" || arg == "test-token")
+        );
+        assert!(
+            cmd.get_envs()
+                .any(|(key, value)| key == "CARGO_REGISTRY_TOKEN"
+                    && value == Some(std::ffi::OsStr::new("test-token")))
+        );
+    }
+}

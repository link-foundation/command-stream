+    {
+        Ok(response) => classify_api_status(response.status()),
+        Err(ureq::Error::Status(status, _)) => classify_api_status(status),
+        Err(e) => Visibility::Unknown(format!("crates.io API request failed: {}", e)),
+    }
+}

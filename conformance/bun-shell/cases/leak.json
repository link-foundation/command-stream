      "disposition": "case",
      "cases": [
        {
          "id": "leak/fdleak-redirect-file",
          "template": ["echo hello > test.txt"],
          "expect": {
            "files": {
              "test.txt": "hello\n"
            }
          }
        },
        {
          "id": "leak/fdleak-change-cwd",
          "template": ["cd ", " && cd -"],
          "values": [
            {
              "string": "{{TEMP}}"
            }
          ],
          "expect": {
            "stdout": ""
          }
        },
        {
          "id": "leak/fdleak-pipeline",
          "template": ["echo hi | cat"],
          "expect": {
            "stdout": "hi\n"
          }
        },
        {
          "id": "leak/fdleak-pipeline2",
          "template": ["echo hi | echo lol | cat"],
          "expect": {
            "stdout": "lol\n"
          }
        },
        {
          "id": "leak/fdleak-ls",
          "template": [
            "mkdir foo; touch ./foo/lol ./foo/nice ./foo/lmao; mkdir foo/bar; touch ./foo/bar/great; touch ./foo/bar/wow; ls -R foo/"
          ],
          "expect": {
            "stdout": {
              "sortedLines": [
                "lmao",
                "lol",
                "nice",
                "foo/bar:",
                "bar",
                "great",
                "wow"
              ]
            }
          },
          "note": "Bun's ls does not sort entries (directory order), so upstream compares sorted non-empty lines"
        },
        {
          "id": "leak/fdleak-rm",
          "template": [
            "mkdir foo; touch ./foo/lol ./foo/nice ./foo/lmao; mkdir foo/bar; touch ./foo/bar/great; touch ./foo/bar/wow; rm -rfv foo/"
          ],
          "expect": {
            "stdout": {
              "sortedLines": [
                "foo/",
                "foo/bar",
                "foo/bar/great",
                "foo/bar/wow",
                "foo/lmao",
                "foo/lol",
                "foo/nice"
              ]
            },
            "absent": ["foo"]
          },
          "note": "rm -v prints removal order depth-first in directory order; compared as sorted lines like upstream"
        }
      ],
      "note": "Upstream runs each TestBuilder command 1000 (ls: 500, rm: 100) times in a `bun --smol test` subprocess and fails if /proc/self/fd grows by > 5 afterwards. The fd counting is Bun-internal; each command's observable TestBuilder expectations are reproduced once."
    },

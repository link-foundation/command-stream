            }
          ],
          "files": {
            "test.ts": "export {};\n"
          },
          "languages": ["js"],
          "expect": {
            "stdout": "{{TEMP}}/test.ts\n"
          }
        },
        {
          "id": "bunshell-file/path-string-arg-prints-path",
          "template": ["echo ", ""],
          "values": [
            {
              "path": "test.ts"
            }
          ],
          "files": {
            "test.ts": "export {};\n"
          },
          "expect": {
            "stdout": "{{TEMP}}/test.ts\n"
          }
        }
      ]
    }
  ]
}

          "expect": {
            "stdout": "\n",
            "exitCode": 0
          }
        }
      ]
    },
    {
      "line": 8,
      "upstream": "single argument",
      "disposition": "case",
      "cases": [
        {
          "id": "commands-echo/single-arg",
          "template": ["echo hello"],
          "expect": {
            "stdout": "hello\n"
          }
        }
      ]
    },
    {

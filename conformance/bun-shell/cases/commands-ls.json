    {
      "line": 304,
      "upstream": "errors > permission denied directory",
      "disposition": "case",
      "cases": [
        {
          "id": "commands-ls/permission-denied-dir",
          "template": ["ls restricted"],
          "dirs": ["restricted"],
          "setup": [
            {
              "template": ["chmod 000 restricted"]
            }
          ],
          "platforms": ["posix"],
          "requires": ["chmod"],
          "expect": {
            "stderr": "ls: restricted: Permission denied\n",
            "exitCode": 1
          },
          "note": "Relies on chmod 000 denying access: fails when the suite runs as root (root bypasses permission bits). Upstream checks stderr contains 'Permission denied'."
        },
        {
          "id": "commands-ls/permission-denied-symlink-to-dir",
          "template": ["ls link-to-restricted"],
          "dirs": ["restricted"],
          "files": {
            "link-to-restricted": {
              "symlink": "restricted"
            }
          },
          "setup": [
            {
              "template": ["chmod 000 restricted"]
            }
          ],
          "platforms": ["posix"],
          "requires": ["chmod"],
          "expect": {
            "stdout": "",
            "stderr": "ls: link-to-restricted: Permission denied\n",
            "exitCode": 1
          },
          "note": "Relies on chmod 000 denying access: fails when the suite runs as root (root bypasses permission bits). A symlink to a directory that cannot be opened reports the open error instead of being listed by name."
        }
      ]
    },
    {
      "line": 326,
      "upstream": "errors > permission denied directory recursive",
      "disposition": "case",
      "cases": [
        {
          "id": "commands-ls/permission-denied-recursive",
          "template": ["ls -R level1"],
          "files": {
            "level1/file1": "",
            "level1/file2": "",
            "level1/file3": "",
            "level1/level2/file4": "",
            "level1/level2/file5": "",
            "level1/level2/file6": "",
            "level1/level2/level3/file7": "",
            "level1/level2/level3/file8": "",
            "level1/level2/level3/file9": ""
          },
          "setup": [
            {
              "template": ["chmod 000 level1/level2"]
            }
          ],
          "platforms": ["posix"],
          "requires": ["chmod"],
          "expect": {
            "stdout": {
              "sortedLines": ["file1", "file2", "file3", "level2"]
            },
            "stderr": "ls: level1/level2: Permission denied\n",
            "exitCode": 1
          },
          "note": "Relies on chmod 000 denying access: fails when the suite runs as root (root bypasses permission bits). The listing continues past the unreadable subdirectory and the exit code is 1. Runners should `chmod 755 level1/level2` before deleting the temp dir (upstream does this as cleanup)."
        }
      ]
    },
    {
      "line": 352,
      "upstream": "errors > broken symlink file",
      "disposition": "case",
      "cases": [
        {
          "id": "commands-ls/broken-symlink-file",
          "template": ["ls broken-link"],
          "files": {
            "will-remove": "",
            "broken-link": {
              "symlink": "will-remove"
            }
          },
          "setup": [
            {
              "template": ["rm will-remove"]
            }
          ],
          "platforms": ["posix"],
          "expect": {
            "stdout": "broken-link\n",
            "exitCode": 0
          }
        },
        {
          "id": "commands-ls/broken-symlink-file-long",
          "template": ["ls -l broken-link"],
          "files": {
            "will-remove": "",
            "broken-link": {
              "symlink": "will-remove"
            }
          },
          "setup": [
            {
              "template": ["rm will-remove"]
            }
          ],
          "platforms": ["posix"],
          "expect": {
            "stdout": {
              "regex": "^lrwx[-rwxsStT]{6} +1 +\\S+ +\\S+ +11 .* broken-link\\n$"
            },
            "exitCode": 0
          },
          "note": "upstream: stdout starts with 'lrwx' and ends with ' broken-link\\n' (symlink perms differ Linux 0777 / macOS 0755). Size column is the link target length (11)."
        }
      ]
    },

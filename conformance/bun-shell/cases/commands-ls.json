    {
      "line": 72,
      "upstream": "recursive > node_modules",
      "disposition": "case",
      "cases": [
        {
          "id": "commands-ls/recursive-node-modules",
          "template": ["ls -RA ."],
          "files": {
            "package.json": "{\"name\":\"dummy\"}\n",
            "node_modules/.package-lock.json": "{}\n",
            "node_modules/.bin/tsc": {
              "symlink": "../typescript/bin/tsc"
            },
            "node_modules/typescript/package.json": "{}\n",
            "node_modules/typescript/bin/tsc": "#!/usr/bin/env node\n",
            "node_modules/typescript/lib/typescript.js": "",
            "node_modules/typescript/lib/tsc.js": "",
            "node_modules/react/package.json": "{}\n",
            "node_modules/react/index.js": "",
            "node_modules/react/cjs/react.development.js": "",
            "node_modules/react/cjs/react.production.min.js": "",
            "node_modules/@types/react/index.d.ts": "",
            "node_modules/@types/react/package.json": "{}\n",
            "node_modules/esbuild/.npmignore": "",
            "node_modules/esbuild/install.js": ""
          },
          "platforms": ["posix"],
          "expect": {
            "stdout": {
              "sortedLines": [
                "node_modules",
                "package.json",
                "./node_modules:",
                ".bin",
                ".package-lock.json",
                "@types",
                "esbuild",
                "react",
                "typescript",
                "./node_modules/.bin:",
                "tsc",
                "./node_modules/@types:",
                "react",
                "./node_modules/@types/react:",
                "index.d.ts",
                "package.json",
                "./node_modules/esbuild:",
                ".npmignore",
                "install.js",
                "./node_modules/react:",
                "cjs",
                "index.js",
                "package.json",
                "./node_modules/react/cjs:",
                "react.development.js",
                "react.production.min.js",
                "./node_modules/typescript:",
                "bin",
                "lib",
                "package.json",
                "./node_modules/typescript/bin:",
                "tsc",
                "./node_modules/typescript/lib:",
                "tsc.js",
                "typescript.js"
              ]
            }
          },
          "note": "upstream runs `bun install` of a real package.json (network) then checks `ls -RA .` lists every entry; reproduced with a synthetic node_modules tree (incl. dot entries and a symlink to a file, which is listed but not followed)"
        }
      ]
    },
    {
      "line": 79,
      "upstream": "recursive > basic",
      "disposition": "case",
      "cases": [
        {
          "id": "commands-ls/recursive-basic",
          "template": ["ls -RA ."],
          "files": {
            "a": "",
            "b": "",
            "c": "",
            "foo/a": "",
            "foo/b": "",
            "foo/c": ""
          },
          "expect": {
            "stdout": {
              "sortedLines": ["./foo:", "a", "a", "b", "b", "c", "c", "foo"]
            }
          },
          "note": "Bun lists the top-level directory without a '.:' header; subdirectory headers are './foo:'. Entry order is readdir/concurrency dependent, hence sortedLines."
        }
      ]
    },

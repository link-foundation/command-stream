    {
      "line": 299,
      "upstream": "recursive rm reports an entry deeper than PATH_MAX instead of crashing",
      "disposition": "case",
      "cases": [
        {
          "id": "commands-rm/deeper-than-path-max-file",
          "template": ["rm -rf ", ""],
          "values": [
            {
              "path": "file"
            }
          ],
          "files": {
            "mk.cjs": "const fs = require('fs');\nconst path = require('path');\nconst tag = process.argv[2];\nconst PATH_MAX = process.platform === 'linux' ? 4096 : 1024;\nconst base = process.cwd();\nconst deepLength = PATH_MAX - 64;\nconst component = 'd'.repeat(100);\nlet dir = path.join(base, tag);\nwhile (Buffer.byteLength(dir) + 1 + component.length <= deepLength) dir = path.join(dir, component);\nconst rest = deepLength - Buffer.byteLength(dir) - 1;\nif (rest > 0) dir = path.join(dir, 'e'.repeat(rest));\nfs.mkdirSync(dir, { recursive: true });\nprocess.chdir(dir);\nif (tag === 'file') fs.writeFileSync('f'.repeat(100), '');\nelse fs.mkdirSync('s'.repeat(100));\n"
          },
          "setup": [
            {
              "template": ["", " mk.cjs file"],
              "values": [
                {
                  "string": "{{NODE}}"
                }
              ]
            }
          ],
          "platforms": ["posix"],
          "requires": ["node"],
          "expect": {
            "stderr": {
              "allOf": [
                {
                  "startsWith": "rm: {{TEMP}}/file/"
                },
                {
                  "regex": "^rm: /\\S+/f{100}: File name too long\\n$"
                }
              ]
            },
            "exitCode": 1,
            "exists": ["file"]
          },
          "note": "setup builds <TEMP>/file/ddd.../eee (absolute length PATH_MAX-64; PATH_MAX 4096 on Linux, 1024 elsewhere) containing a 100-char file 'fff...', so that entry's full path is >= PATH_MAX. rm must report exactly that entry as 'File name too long' (upstream also checks its byte length >= PATH_MAX) and keep its directory. Runners may be unable to delete the leftover tree with path-based APIs."
        },
        {
          "id": "commands-rm/deeper-than-path-max-dir",
          "template": ["rm -rf ", ""],
          "values": [
            {
              "path": "dir"
            }
          ],
          "files": {
            "mk.cjs": "const fs = require('fs');\nconst path = require('path');\nconst tag = process.argv[2];\nconst PATH_MAX = process.platform === 'linux' ? 4096 : 1024;\nconst base = process.cwd();\nconst deepLength = PATH_MAX - 64;\nconst component = 'd'.repeat(100);\nlet dir = path.join(base, tag);\nwhile (Buffer.byteLength(dir) + 1 + component.length <= deepLength) dir = path.join(dir, component);\nconst rest = deepLength - Buffer.byteLength(dir) - 1;\nif (rest > 0) dir = path.join(dir, 'e'.repeat(rest));\nfs.mkdirSync(dir, { recursive: true });\nprocess.chdir(dir);\nif (tag === 'file') fs.writeFileSync('f'.repeat(100), '');\nelse fs.mkdirSync('s'.repeat(100));\n"
          },
          "setup": [
            {
              "template": ["", " mk.cjs dir"],
              "values": [
                {
                  "string": "{{NODE}}"
                }
              ]
            }
          ],
          "platforms": ["posix"],
          "requires": ["node"],
          "expect": {
            "stderr": {
              "allOf": [
                {
                  "startsWith": "rm: {{TEMP}}/dir/"
                },
                {
                  "regex": "^rm: /\\S+/s{100}: File name too long\\n$"
                }
              ]
            },
            "exitCode": 1,
            "exists": ["dir"]
          },
          "note": "same as the file variant but the too-deep entry is a 100-char directory 'sss...'"
        },
        {
          "id": "commands-rm/deeper-than-path-max-plain",
          "template": ["rm -rf ", ""],
          "values": [
            {
              "path": "plain"
            }
          ],
          "dirs": ["plain/sub"],
          "platforms": ["posix"],
          "expect": {
            "absent": ["plain"]
          }
        }
      ]
    },
    {
      "line": 386,
      "upstream": "relative operands are resolved against the shell cwd, not the process cwd",
      "disposition": "case",
      "cases": [
        {
          "id": "commands-rm/rm-rf-dot-shell-cwd",
          "template": ["rm -rf ."],
          "cwd": "work",
          "files": {
            "work/file.txt": "content",
            "work/sub/inner.txt": "content",
            "keep.txt": "keep"
          },
          "platforms": ["posix"],
          "expect": {
            "stderr": {
              "regex": "^rm: \\.: "
            },
            "exitCode": 1,
            "exists": ["work", "keep.txt"]
          },
          "note": "HAZARD: an implementation that resolves '.' against the PROCESS cwd would wipe it; run the corpus from a scratch process cwd. Upstream runs the $ with .cwd(work) from a child whose process cwd is '/'."
        },
        {
          "id": "commands-rm/rm-rf-dot-shell-cwd-linux",
          "template": ["rm -rf ."],
          "cwd": "work",
          "files": {
            "work/file.txt": "content",
            "work/sub/inner.txt": "content",
            "keep.txt": "keep"
          },
          "platforms": ["linux"],
          "expect": {
            "stderr": "rm: .: Invalid argument\n",
            "exitCode": 1,
            "exists": ["work", "keep.txt"],
            "absent": ["work/file.txt", "work/sub"]
          },
          "note": "Linux only: children of '.' are removed, then removing '.' itself fails with EINVAL (exact message is Bun 1.4.2 on Linux; upstream only checks /^rm: \\.: /). HAZARD as above."
        }
      ]
    },

{
  "source": "test/js/bun/shell/shell-blocking-pipe.test.ts",
  "units": [
    {
      "line": 9,
      "upstream": "writing > send buffer size doesn't block the main thread",
      "disposition": "case",
      "cases": [
        {
          "id": "shell-blocking-pipe/raw-1mb-echo-to-system-cat",
          "template": ["", ""],
          "values": [
            {
              "raw": {
                "concat": [
                  "echo ",
                  {
                    "repeat": "bun!",
                    "count": 262144
                  },
                  " | $(which cat)"
                ]
              }
            }
          ],
          "expect": {
            "stdout": {
              "concat": [
                {
                  "repeat": "bun!",
                  "count": 262144
                },
                "\n"
              ]
            }
          },
          "platforms": ["posix"],
          "requires": ["cat"],
          "timeoutMs": 15000,
          "note": "upstream builds the raw script with Bun.which('cat') (system cat); here `$(which cat)` resolves the external cat. generateHeapSnapshot part is Bun-internal."
        },
        {
          "id": "shell-blocking-pipe/raw-1mb-echo-to-builtin-cat",
          "template": ["", ""],
          "values": [
            {
              "raw": {
                "concat": [
                  "echo ",
                  {
                    "repeat": "bun!",
                    "count": 262144
                  },
                  " | cat"
                ]
              }
            }
          ],
          "expect": {
            "stdout": {
              "concat": [
                {
                  "repeat": "bun!",
                  "count": 262144
                },
                "\n"
              ]
            }
          },
          "platforms": ["posix"],
          "note": "same with the builtin cat"
        }
      ]
    },

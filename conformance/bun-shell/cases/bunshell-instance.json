{
  "source": "test/js/bun/shell/bunshell-instance.test.ts",
  "units": [
    {
      "line": 6,
      "upstream": "new $.Shell() inherits process.env and throws on non-zero exit by default",
      "disposition": "js-api",
      "api": "In a fresh process with env BUN_SHELL_INSTANCE_MARKER=hello: const inst = new $.Shell(); (await $`echo $BUN_SHELL_INSTANCE_MARKER`.quiet()).stdout.toString().trim() === \"hello\" and (await inst`echo $BUN_SHELL_INSTANCE_MARKER`.quiet()).stdout.toString().trim() === \"hello\" (a new instance inherits process.env); `await $`false`.quiet()` and `await inst`false`.quiet()` both reject with an error that is instanceof $.ShellError and has exitCode 1 (both default to throwing); stderr of the process is empty and it exits 0.",
      "cases": [
        {
          "id": "bunshell-instance/inherits-process-env",
          "template": ["echo $BUN_SHELL_INSTANCE_MARKER"],
          "env": {
            "BUN_SHELL_INSTANCE_MARKER": "hello"
          },
          "expect": {
            "stdout": "hello\n"
          }
        },
        {
          "id": "bunshell-instance/false-throws-by-default",
          "template": ["false"],
          "throws": true,
          "expect": {
            "error": "Failed with exit code 1",
            "exitCode": 1,
            "stdout": "",
            "stderr": ""
          }
        }
      ]
    },
    {
      "line": 39,
      "upstream": "$$",
      "disposition": "js-api",
      "api": "const $$ = new $.Shell(); $$.env({BUN: \"bun\"}); (await $$`echo $BUN`).stdout.toString() === \"bun\\n\"; the parent is unaffected: (await $`echo $BUN`).stdout.toString() === \"\\n\"; then $.env({BUN: \"bun2\"}) on the default instance does not affect $$: (await $$`echo $BUN`) -> \"bun\\n\", while (await $`echo $BUN`) -> \"bun2\\n\". Each Shell instance has its own env; .env() on an instance replaces that instance's env only.",
      "cases": [
        {
          "id": "bunshell-instance/env-var-set",
          "template": ["echo $BUN"],
          "env": {
            "BUN": "bun"
          },
          "expect": {
            "stdout": "bun\n"
          }
        },
        {
          "id": "bunshell-instance/env-var-unset-expands-empty",
          "template": ["echo $BUN"],
          "env": {
            "PATH": "/usr/bin:/bin"
          },
          "envReplace": true,
          "expect": {
            "stdout": "\n"
          }
        },
        {
          "id": "bunshell-instance/env-var-set-other-value",
          "template": ["echo $BUN"],
          "env": {
            "BUN": "bun2"
          },
          "expect": {
            "stdout": "bun2\n"
          }
        }
      ]
    },

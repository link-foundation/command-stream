      "disposition": "case",
      "note": "Blob and Response are immutable and cannot be used as a stdout redirect target; Bun 1.4.2 throws TypeError \"Blobs are immutable, and cannot be used for stdout/stderr\" for both",
      "cases": [
        {
          "id": "bunshell-instance/stdout-redirect-to-blob-throws",
          "template": ["cat src.txt > ", ""],
          "values": [
            {
              "blob": {
                "repeat": "hello world!",
                "count": 9000
              }
            }
          ],
          "files": {
            "src.txt": {
              "repeat": "the quick brown fox jumps over the lazy dog 0123456789\n",
              "count": 60
            }
          },
          "languages": ["js"],
          "expect": {
            "error": {
              "byPlatform": {
                "windows": {
                  "contains": "Cannot redirect stdout/stderr to an immutable blob. Expected a file"
                },
                "posix": {
                  "contains": "Blobs are immutable, and cannot be used for stdout/stderr"
                }
              }
            }
          },
          "note": "Bun words this error differently on Windows"
        },
